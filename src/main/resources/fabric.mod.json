{
  "schemaVersion": 1,
  "id": "vanilly",
  "version": "$modVersion",
  "name": "Vanilly",
  "description": "Adding many useful features for Vanilla-like gameplay.",
  "authors": [
    "qdbp"
  ],
  "contact": {
    "homepage": "https://qdbp.codes/",
    "sources": "https://github.com/todo",
    "issues": "https://github.com/todo"
  },
  "license": "CC0-1.0",
  "icon": "assets/vanilly/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      {
        "value": "codes.qdbp.vanilly.Vanilly",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "vanilly.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=$fabricLoaderVersion",
    "minecraft": "$minecraftVersion",
    "java": ">=25",
    "fabric-api": ">=$fabricApiVersion",
    "fabric-language-kotlin": ">=$fabricKotlinVersion"
  }
}